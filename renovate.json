{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Group all non-major updates into a single PR per ecosystem",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Auto-merge patch-level updates once CI is green",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Keep all Symfony packages in lock-step",
      "matchPackageNames": ["symfony/**"],
      "groupName": "symfony"
    },
    {
      "description": "Major updates require explicit approval via the dependency dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Hold Symfony at 8.0 until the object-mapper 8.1 migration is done (patches still flow)",
      "matchPackageNames": ["symfony/**"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      "description": "Do not propose raising the PHP platform requirement",
      "matchDepNames": ["php"],
      "enabled": false
    }
  ]
}
