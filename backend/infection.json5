{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.32/resources/schema.json",
    "source": {
        // Services hold most business logic; entities hold the rich pure logic
        // (Chore recurrence, ShoppingListItem transitions, Product barcode guard).
        // Pure data-holder entities (only accessors + ORM lifecycle) are excluded
        // so the MSI reflects real logic, not getter noise.
        "directories": [
            "src/Service",
            "src/Entity"
        ],
        "excludes": [
            "Barcode.php",
            "StockEntry.php",
            "RecipeIngredient.php",
            "Recipe.php",
            "Category.php",
            "Location.php",
            "User.php"
        ]
    },
    "logs": {
        "text": "var/infection.log",
        "html": "var/infection.html"
    },
    "mutators": {
        "@default": true
    },
    "phpUnit": {
        "configDir": "."
    },
    // Timeout per test in seconds - functional tests are slower
    "timeout": 30,
    // Run tests in parallel using available CPU cores
    "threads": 16
}
