{
	skip_install_trust

	log default {
		output discard
	}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"

	# Defence in depth: scripts, fetch and frames are locked to this origin.
	# The SPA needs two relaxations: img-src data: (inline SVG icons in the
	# compiled CSS) and style-src 'unsafe-inline' (react-hot-toast injects a
	# <style> element at runtime; a nonce would need per-request generation
	# that Caddy does not do). Dev overrides CSP_POLICY for Swagger UI
	# (compose.override.yaml); prod keeps the default below.
	header {
		Content-Security-Policy "{$CSP_POLICY:default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'}"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# hestia: SPA fallback. Any non-file path outside the backend's own prefixes
	# is a client-side route and gets the app shell, which the prod image bakes
	# into /app/public. In dev the shell is served by Vite, index.html does not
	# exist here, and such paths fall through to Symfony (404) as upstream does.
	@spaRoute {
		not file {path}
		not path /api/* /_error/*
		file /index.html
	}
	rewrite @spaRoute /index.html

	@phpRoute {
		not file {path}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	file_server {
		hide *.php
	}
}
