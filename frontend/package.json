    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "ajv": "^8.17.1",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "orval": "^8.0.1",
    "tailwindcss": "^4.1.18",
