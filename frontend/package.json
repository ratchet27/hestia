    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "ajv": "^8.20.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "orval": "^8.14.0",
    "tailwindcss": "^4.3.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
